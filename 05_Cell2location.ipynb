  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "### 7.3 Diversidad celular por spot (entropía de Shannon)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "adata_vis_infer.obs['shannon_diversity'] = props_all[cell_types].apply(lambda r: entropy(r, base=2), axis=1)\n",
