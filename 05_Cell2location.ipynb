    "            sub, color='shannon_diversity', library_id=sample_name, cmap='viridis',\n",
    "            size=1.3, img_key='hires', show=False,\n",
    "            title=f\"Cell-type diversity (Shannon entropy) — {sample_name}\",\n",
    "        )\n",
    "        plt.savefig(f'/home/imartinezle/Figuras/figuras_{sample_name}/Cell2location/shannon_diversity_{sample_name}.png',\n",
    "                     dpi=200, bbox_inches=\"tight\")\n",
    "        plt.show()\n"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 8. Guardar resultados en la cadena de h5ad\n",
    "\n",
    "Hasta aquí todo se ha trabajado sobre `adata_vis_infer`, el objeto combinado\n",
    "de las 4 muestras (necesario para el entrenamiento conjunto). Para seguir la\n",
    "convención del resto del pipeline, aquí se reparte de vuelta: por cada\n",
    "muestra, se recarga su h5ad individual (`{sample}_infercnv.h5ad`, salida del\n",
    "script 04) y se le añaden las columnas nuevas calculadas en este notebook\n",
    "(abundancia de cada tipo celular, región de Leiden por composición, entropía\n",
    "de Shannon), y se guarda como `{sample}_cell2location.h5ad`.\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "for sample_name in SAMPLES:\n",
    "    sub = adata_vis_infer[adata_vis_infer.obs['sample'] == sample_name]\n",
    "\n",
    "    # ad.concat con index_unique=\"_\" dejó los barcodes como \"<barcode>_<sample>\";\n",
    "    # se recupera el barcode original para poder indexar el h5ad individual\n",
    "    barcodes_originales = sub.obs_names.str.replace(f\"_{sample_name}$\", \"\", regex=True)\n",
    "\n",
    "    adata_sample = sc.read_h5ad(VIS_PATHS[sample_name])\n",
    "    adata_sample = adata_sample[barcodes_originales].copy()\n",
    "\n",
    "    abundancias = sub.obsm[abundance_key].copy()\n",
    "    abundancias.index = barcodes_originales\n",
    "    for ct in cell_types:\n",
    "        adata_sample.obs[f\"c2l_{ct}\"] = abundancias.loc[adata_sample.obs_names, ct].values\n",
    "\n",
    "    adata_sample.obs['c2l_leiden_region'] = sub.obs['leiden'].values\n",
    "    adata_sample.obs['c2l_shannon_diversity'] = sub.obs['shannon_diversity'].values\n",
    "\n",
    "    output_path = f\"{H5AD_DIR}{sample_name}_cell2location.h5ad\"\n",
    "    adata_sample.write_h5ad(output_path)\n",
    "    print(f\"{sample_name}: guardado en {output_path} ({adata_sample.n_obs} spots)\")\n"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "### 8.1 Tabla resumen (opcional, para trabajar fuera de Python)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "export_cols = list(cell_types) + ['shannon_diversity']\n",
    "if 'array_row' in adata_vis_infer.obs.columns and 'array_col' in adata_vis_infer.obs.columns:\n",
    "    export_cols = ['sample', 'array_row', 'array_col'] + export_cols\n",
    "else:\n",
    "    export_cols = ['sample'] + export_cols\n",
    "\n",
