   "outputs": [],
   "source": [
    "if signature_needed:\n",
    "    ax = plt.gca()\n",
    "    ax.plot(\n",
    "        np.array(mod_ref.history_[\"elbo_train\"].index),\n",
    "        np.array(mod_ref.history_[\"elbo_train\"].values.flatten()),\n",
    "        label=\"train\",\n",
    "    )\n",
    "    ax.legend()\n",
    "    ax.set_xlim(0, len(mod_ref.history_[\"elbo_train\"]))\n",
    "    ax.set_xlabel(\"Training epochs\")\n",
    "    ax.set_ylabel(\"-ELBO loss\")\n",
    "    ax.set_title(\"Reference signature model training\")\n",
    "    plt.savefig(os.path.join(FIGURES_DIR, \"ref_model_elbo.png\"), dpi=150, bbox_inches=\"tight\")\n",
    "    plt.show()\n",
    "\n",
    "    # Control de calidad: se debe observar una tendencia lineal\n",
    "    mod_ref.plot_QC()\n",
    "    plt.savefig(os.path.join(FIGURES_DIR, \"ref_model_qc.png\"), dpi=150, bbox_inches=\"tight\")\n",
    "    plt.show()\n"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "6f9d6257",
   "metadata": {},
   "source": [
    "### 2.3 Exportación de la firma de referencia"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "ff2a6c1d",
   "metadata": {},
   "outputs": [],
   "source": [
    "if signature_needed:\n",
    "    # Exportamos el posterior (media/varianza de la firma por tipo celular)\n",
    "    adata_ref_infer = mod_ref.export_posterior(\n",
    "        adata_ref_filt, sample_kwargs={'num_samples': 1000, 'batch_size': 2500}\n",
    "    )\n",
    "    mod_ref.save(SIGNATURE_DIR, overwrite=True)\n",
    "\n",
    "    if 'means_per_cluster_mu_fg' in adata_ref_infer.varm.keys():\n",
    "        inf_aver = adata_ref_infer.varm['means_per_cluster_mu_fg'][\n",
    "            [f'means_per_cluster_mu_fg_{i}' for i in adata_ref_infer.uns['mod']['factor_names']]\n",
    "        ].copy()\n",
    "    else:\n",
    "        inf_aver = adata_ref_infer.var[\n",
    "            [f'means_per_cluster_mu_fg_{i}' for i in adata_ref_infer.uns['mod']['factor_names']]\n",
    "        ].copy()\n",
    "\n",
    "    inf_aver.columns = adata_ref_infer.uns['mod']['factor_names']\n",
    "    inf_aver.to_csv(INFER_AVER_PATH)\n",
    "    del adata_ref_infer, adata_ref_filt, adata_ref\n",
    "\n",
    "# A partir de aquí siempre se trabaja con el CSV guardado en disco, se haya\n",
    "# entrenado ahora mismo o en una ejecución anterior -> una única fuente de verdad.\n",
    "inf_aver = pd.read_csv(INFER_AVER_PATH, index_col=0)\n",
    "print(f\"Firma de referencia: {inf_aver.shape[0]} genes x {inf_aver.shape[1]} tipos celulares\")\n",
    "inf_aver.head()\n"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "13659640",
   "metadata": {},
   "source": [
    "## 3. Mapeo espacial de abundancias celulares (Cell2location)\n",
    "\n",
    "Toda esta sección (carga de las 4 muestras Visium, combinación, y entrenamiento de\n",
    "Cell2location) solo se ejecuta si `c2l_needed` es `True`. Si el mapeo ya está\n",
    "calculado y guardado, se salta directamente a la celda de carga del `.h5ad` final,\n",
    "al final de esta sección.\n"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "91344e3a",
   "metadata": {},
   "source": [
    "### 3.1 Carga y combinación de las cuatro muestras espaciales"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "if c2l_needed:\n",
    "    adatas = {}\n",
    "    for sample_name, vis_path in VIS_PATHS.items():\n",
    "        a = sc.read_h5ad(vis_path)\n",
    "        a.X = a.layers[\"counts\"].copy()   # counts crudos, preservados desde el notebook 01\n",
    "        a.var_names_make_unique()\n",
    "        adatas[sample_name] = a\n",
    "        print(f\"{sample_name}: {a.shape}\")\n",
    "\n",
    "    concat_flt = ad.concat(\n",
    "        adatas, index_unique=\"_\", label=\"sample\", merge=\"same\", uns_merge=\"first\"\n",
    "    )\n",
    "\n",
    "    # fix: ad.concat con uns_merge=\"first\" solo conserva las imágenes H&E de la\n",
    "    # primera muestra en concat_flt.uns['spatial']. Se reconstruye a mano para\n",
    "    # que los plots espaciales (sc.pl.spatial, quesitos, etc.) funcionen para las 4.\n",
    "    concat_flt.uns['spatial'] = {s: adatas[s].uns['spatial'][s] for s in SAMPLES}\n",
    "\n",
    "    # descartamos spots sin anotación del patólogo\n",
    "    concat_flt = concat_flt[\n",
    "        ~concat_flt.obs[\"Layer_patologo\"].astype(str).str.lower().isin([\"unannotated\", \"unknown\", \"nan\"])\n",
    "    ].copy()\n",
    "\n",
    "    sc.pp.filter_genes(concat_flt, min_cells=2)\n",
    "    print(f\"Shape combinado (4 muestras, spots anotados): {concat_flt.shape}\")\n",
    "    print(concat_flt.obs[\"sample\"].value_counts())\n"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "60d1bc6d",
   "metadata": {},
   "source": [
    "### 3.2 Configuración y entrenamiento del modelo Cell2location"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "15ea9e5d",
   "metadata": {},
   "outputs": [],
   "source": [
    "if c2l_needed:\n",
    "    intersect = np.intersect1d(concat_flt.var_names, inf_aver.index)\n",
    "    adata_vis = concat_flt[:, intersect].copy()\n",
    "    inf_aver_shared = inf_aver.loc[intersect, :].copy()\n",
    "    print(f\"Genes compartidos entre firma de referencia y datos espaciales: {len(intersect)}\")\n",
    "\n",
    "    Cell2location.setup_anndata(adata=adata_vis, batch_key=\"sample\")\n",
    "\n",
    "    # NOTA sobre memoria GPU: los hiperparámetros de aquí abajo (N_cells_per_location,\n",
    "    # A_factors_per_location, n_groups, B_groups_per_location...) son priors\n",
    "    # estadísticos del modelo -- afectan a la regularización, no son la causa\n",
    "    # principal de un OOM. El cuello de botella real es batch_size=None en\n",
    "    # mod.train()/export_posterior(), que carga TODO el dataset espacial de golpe\n",
    "    # en la GPU (por eso el cambio clave está más abajo, en el entrenamiento).\n",
    "    mod = Cell2location(\n",
    "        adata_vis,\n",
    "        cell_state_df=inf_aver_shared,\n",
    "        N_cells_per_location=10,\n",
    "        N_cells_mean_var_ratio=1.0,\n",
    "        A_factors_per_location=7.0,\n",
    "        n_groups=5,                      # reducido de 15 a 5: menos parámetros a estimar\n",
    "        B_groups_per_location=2.0,\n",
    "        detection_mean=0.5,\n",
    "        detection_alpha=20,\n",
    "        detection_mean_per_sample=False,\n",
    "        detection_hyp_prior={\"mean_alpha\": 10},\n",
    "        m_g_gene_level_prior={\"mean\": 1, \"mean_var_ratio\": 1.0, \"alpha_mean\": 3.0},\n",
    "        gene_add_alpha_hyp_prior={\"alpha\": 9.0, \"beta\": 3.0},\n",
    "        gene_add_mean_hyp_prior={\"alpha\": 1.0, \"beta\": 100.0},\n",
    "        alpha_g_phi_hyp_prior={\"alpha\": 9.0, \"beta\": 3.0},\n",
    "        w_sf_mean_var_ratio=5.0,\n",
    "    )\n",
    "    try:\n",
    "        mod.view_anndata_setup()\n",
    "    except AttributeError as e:\n",
    "        print(f\"(Aviso: no se pudo mostrar el resumen de configuración — {e}. No afecta al entrenamiento.)\")\n",
    "\n",
    "    # batch_size=C2L_BATCH_SIZE (en vez de None) procesa los spots en mini-lotes\n",
    "    # en vez de cargar el dataset espacial completo de golpe en la GPU.\n",
    "    mod.train(\n",
    "        max_epochs=C2L_N_EPOCHS,\n",
    "        batch_size=C2L_BATCH_SIZE,\n",
    "        train_size=1,\n",
    "        accelerator=ACCELERATOR,\n",
    "        precision=32,\n",
    "        early_stopping=True,\n",
    "        early_stopping_monitor=\"elbo_train\",\n",
    "        early_stopping_patience=C2L_EARLY_STOPPING_PATIENCE,\n",
    "    )\n"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "9e718b20",
   "metadata": {},
   "source": [
    "### 3.3 Diagnóstico del entrenamiento de Cell2location"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "b8aa8a02",
   "metadata": {},
   "outputs": [],
   "source": [
    "if c2l_needed:\n",
    "    mod.plot_history()\n",
    "    plt.title(\"Cell2location spatial mapping training\")\n",
    "    plt.savefig(os.path.join(FIGURES_DIR, \"c2l_model_elbo.png\"), dpi=150, bbox_inches=\"tight\")\n",
    "    plt.show()\n",
