   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 6. Mapa espacial de \"quesitos\" por spot (composición celular dominante)\n",
    "\n",
    "**Esta es la figura más importante del notebook.** Cada spot se dibuja como un\n",
    "mini gráfico circular (\"quesito\") con sus `TOP_N_CELLTYPES_PIE` tipos celulares\n",
    "principales (según la abundancia estimada por cell2location), más una porción\n",
    "gris \"Other\" que agrupa el resto de tipos minoritarios.\n",
    "\n",
    "Los 37 subtipos finos del atlas se agrupan en 10 categorías generales (Tumour,\n",
    "Fibroblast, CD8 T...) para que la paleta sea legible: cada categoría tiene un\n",
    "colormap propio, y los subtipos dentro de esa categoría se reparten distintas\n",
    "intensidades del mismo colormap, así se distingue la categoría a simple vista\n",
    "y el subtipo concreto con más atención.\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# mapeo de los 37 subtipos finos del atlas a 10 categorías generales\n",
    "type_to_category = {\n",
    "    \"Cancer.cell.1\": \"Tumour\", \"Cancer.cell.2\": \"Tumour\", \"Cancer.cell.3\": \"Tumour\",\n",
    "    \"Cancer.cell.4\": \"Tumour\", \"Cancer.cell.5\": \"Tumour\", \"Cancer.cell.6\": \"Tumour\",\n",
    "    \"Cycling.cancer.cell.1\": \"Cycling tumour\", \"Cycling.cancer.cell.2\": \"Cycling tumour\",\n",
    "    \"Ciliated.cell.1\": \"Epithelial\", \"Ciliated.cell.2\": \"Epithelial\",\n",
    "    \"Fibroblast\": \"Fibroblast\", \"Endothelial.cell\": \"Endothelial\",\n",
    "    \"CD8.T.cytotoxic\": \"CD8 T\", \"CD8.T.ISG\": \"CD8 T\", \"CD8.T.CXCL13\": \"CD8 T\",\n",
    "    \"CD4.T.naive\": \"CD4 T\", \"CD4.T.reg\": \"CD4 T\", \"CD4.T.CXCL13\": \"CD4 T\",\n",
    "    \"B.cell\": \"B / Plasma\", \"Plasma.cell\": \"B / Plasma\",\n",
    "    \"Cycling.T.NK\": \"NK/ILC\", \"NK.CD56\": \"NK/ILC\", \"NK.cytotoxic\": \"NK/ILC\", \"ILC\": \"NK/ILC\",\n",
    "    \"M1.S100A8\": \"Myeloid\", \"M2.COL1A1\": \"Myeloid\", \"M2.CXCL10\": \"Myeloid\",\n",
    "    \"M2.MARCO\": \"Myeloid\", \"M2.MMP9\": \"Myeloid\", \"M2.SELENOP\": \"Myeloid\",\n",
    "    \"Clearing.M\": \"Myeloid\", \"Cycling.M\": \"Myeloid\", \"cDC1\": \"Myeloid\",\n",
    "    \"cDC2\": \"Myeloid\", \"mDC\": \"Myeloid\", \"pDC\": \"Myeloid\", \"Mast.cell\": \"Myeloid\",\n",
    "}\n",
    "\n",
    "# un colormap por categoría; los subtipos de cada categoría toman distintas\n",
    "# intensidades del mismo colormap (ver mas abajo)\n",
    "category_colors = {\n",
    "    \"Tumour\":         \"Reds\",\n",
    "    \"Cycling tumour\": \"Oranges\",\n",
    "    \"Epithelial\":     \"Purples\",\n",
    "    \"Fibroblast\":     \"Greys\",\n",
    "    \"Endothelial\":    \"PuBu\",\n",
    "    \"CD8 T\":          \"Blues\",\n",
    "    \"CD4 T\":          \"YlGnBu\",\n",
    "    \"B / Plasma\":     \"RdPu\",\n",
    "    \"NK/ILC\":         \"BuPu\",\n",
    "    \"Myeloid\":        \"Greens\",\n",
    "}\n",
    "\n",
    "grouped_subtypes = defaultdict(list)\n",
    "for subtype, category in type_to_category.items():\n",
    "    grouped_subtypes[category].append(subtype)\n",
    "\n",
    "palette = {}\n",
    "for category, subtypes in grouped_subtypes.items():\n",
    "    cmap = plt.get_cmap(category_colors.get(category, \"viridis\"))\n",
    "    intensities = np.linspace(0.4, 0.9, len(subtypes)) if len(subtypes) > 1 else [0.6]\n",
    "    for idx, subtype in enumerate(subtypes):\n",
    "        palette[subtype] = plt.cm.colors.to_hex(cmap(intensities[idx]))\n",
    "palette[\"Other\"] = \"#444444\"\n",
    "\n",
    "print(f\"Paleta creada para {len(palette) - 1} subtipos ({len(category_colors)} categorías) + 'Other'\")\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "props_all = adata_vis_infer.obsm[abundance_key][cell_types]\n",
    "props_all = props_all.div(props_all.sum(axis=1), axis=0)\n",
    "\n",
    "# leyenda: categorías presentes, en un color representativo (intensidad media)\n",
    "categorias_presentes = [c for c in category_colors if c in grouped_subtypes]\n",
    "category_legend_colors = {\n",
    "    cat: plt.cm.colors.to_hex(plt.get_cmap(category_colors[cat])(0.65))\n",
    "    for cat in categorias_presentes\n",
    "}\n",
    "\n",
    "for sample_name in SAMPLES:\n",
    "    sub = adata_vis_infer[adata_vis_infer.obs['sample'] == sample_name]\n",
    "    scalef = adata_vis_infer.uns['spatial'][sample_name]['scalefactors']['tissue_hires_scalef']\n",
    "    coords = sub.obsm['spatial'] * scalef\n",
    "\n",
    "    props = sub.obsm[abundance_key][cell_types].copy()\n",
    "    props = props.div(props.sum(axis=1), axis=0)\n",
    "\n",
    "    fig, ax = plt.subplots(figsize=(8, 8))\n",
    "    for i in range(sub.n_obs):\n",
    "        row = props.iloc[i].sort_values(ascending=False)\n",
    "        fractions = list(row.iloc[:TOP_N_CELLTYPES_PIE])\n",
    "        labels = list(row.index[:TOP_N_CELLTYPES_PIE])\n",
    "        ax.pie(fractions, colors=[palette.get(c, palette[\"Other\"]) for c in labels],\n",
    "               center=coords[i], radius=12, startangle=90,\n",
    "               wedgeprops={'edgecolor': 'white', 'linewidth': 0.15})\n",
    "\n",
    "    ax.set_xlim(coords[:, 0].min() - 50, coords[:, 0].max() + 50)\n",
    "    ax.set_ylim(coords[:, 1].max() + 50, coords[:, 1].min() - 50)\n",
    "    ax.axis('off')\n",
    "    ax.set_title(f\"Spatial composition — {sample_name}\", fontsize=12)\n",
    "\n",
    "    # leyenda por categoría (no por subtipo individual, serían 37 entradas)\n",
    "    handles = [Line2D([], [], marker='o', color='w', markerfacecolor=category_legend_colors[cat],\n",
    "                       markersize=10, label=cat) for cat in categorias_presentes]\n",
    "    handles.append(Line2D([], [], marker='o', color='w', markerfacecolor=palette[\"Other\"],\n",
    "                           markersize=10, label=\"Other (minor types)\"))\n",
    "    ax.legend(handles=handles, bbox_to_anchor=(1.02, 1), loc='upper left', frameon=False, fontsize=9)\n",
    "\n",
    "    plt.savefig(f'/home/imartinezle/Figuras/figuras_{sample_name}/Cell2location/spatial_piecharts_{sample_name}.png',\n",
    "                dpi=200, bbox_inches=\"tight\")\n",
    "    plt.show()\n",
    "    plt.close(fig)\n"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 7. Otras visualizaciones\n",
    "\n",
    "Tres figuras complementarias al quesito espacial, comparando entre las 4\n",
    "muestras a la vez (no van a la carpeta de figuras de una muestra concreta):\n",
    "\n",
    "1. **Barras apiladas** con la composición celular media de cada muestra, por\n",
    "   categoría (agrupando los 37 subtipos finos en las mismas 10 categorías de\n",
    "   la sección anterior).\n",
    "2. **Heatmap de correlación** entre tipos celulares -- qué tipos tienden a\n",
    "   aparecer juntos o excluirse entre spots.\n",
    "3. **Mapa espacial de diversidad celular (entropía de Shannon)** por spot --\n",
    "   útil para localizar zonas de transición tumor-estroma o alta infiltración\n",
    "   inmune.\n"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "### 7.1 Composición celular media por muestra (barras apiladas)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "grouped_props = props_all.T.groupby(type_to_category).sum().T\n",
    "grouped_props['sample'] = adata_vis_infer.obs['sample'].values\n",
    "mean_by_sample = grouped_props.groupby('sample').mean()\n",
    "mean_by_sample = mean_by_sample[categorias_presentes]\n",
    "\n",
    "fig, ax = plt.subplots(figsize=(8, 6))\n",
    "mean_by_sample.plot(kind='bar', stacked=True, ax=ax,\n",
    "                     color=[category_legend_colors[c] for c in categorias_presentes])\n",
    "ax.set_ylabel(\"Mean cell-type proportion\")\n",
    "ax.set_xlabel(\"Sample\")\n",
    "ax.set_title(\"Average cell-type composition per sample (by category)\")\n",
    "ax.spines['top'].set_visible(False)\n",
    "ax.spines['right'].set_visible(False)\n",
    "ax.legend(bbox_to_anchor=(1.02, 1), loc='upper left', fontsize=9, title=\"Category\")\n",
    "plt.xticks(rotation=0)\n",
    "plt.tight_layout()\n",
    "plt.savefig(FIG_DIR_COMPARATIVA + \"stacked_bar_composition_by_sample.png\", dpi=150, bbox_inches=\"tight\")\n",
    "plt.show()\n"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "### 7.2 Correlación entre tipos celulares (across spots)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
